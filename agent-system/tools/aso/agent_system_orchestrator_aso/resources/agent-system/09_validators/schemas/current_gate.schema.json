{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/current_gate.schema.json",
  "title": "CURRENT_GATE",
  "description": "Stage 2 envelope sidecar for project-runtime/CURRENT_GATE.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sidecar_type",
    "markdown_source",
    "state_revision",
    "updated_at",
    "updated_by",
    "content"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "sidecar_type": { "type": "string", "const": "CURRENT_GATE" },
    "markdown_source": { "type": "string", "const": "project-runtime/CURRENT_GATE.md" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "const": "orchestrator" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gate_id",
        "gate_name",
        "gate_type",
        "status",
        "owner_role",
        "task_id",
        "task_packet",
        "action_semantic",
        "workspace_identity_status",
        "repository_lock_status",
        "baseline_tracking_status",
        "checkpoint_eligibility",
        "checkpoint_eligibility_status",
        "project_checkpoint_status",
        "entry_criteria",
        "exit_criteria",
        "required_next_role",
        "gate_evidence",
        "blocking_status",
        "notes"
      ],
      "properties": {
        "gate_id": { "type": "string" },
        "gate_name": { "type": "string" },
        "gate_type": {
          "type": "string",
          "enum": [
            "bootstrap",
            "requirements",
            "design",
            "audit",
            "implementation",
            "testing",
            "setup",
            "run",
            "launch",
            "documentation",
            "handover",
            "correction",
            "finalization",
            "final_acceptance",
            "terminal"
          ]
        },
        "status": {
          "type": "string",
          "enum": ["open", "passed", "failed", "blocked", "skipped"]
        },
        "owner_role": { "$ref": "#/$defs/controlOrOwnerRole" },
        "task_id": { "type": "string" },
        "task_packet": { "type": "string" },
        "action_semantic": { "$ref": "#/$defs/actionSemantic" },
        "workspace_identity_status": {
          "type": "string",
          "enum": ["not_checked", "passed", "failed", "blocked"]
        },
        "repository_lock_status": {
          "type": "string",
          "enum": ["absent", "draft", "accepted", "revoked", "blocked", "not_required"]
        },
        "baseline_tracking_status": {
          "type": "string",
          "enum": ["not_checked", "passed", "blocked", "owner_action_required"]
        },
        "checkpoint_eligibility": {
          "type": "string",
          "enum": ["blocked", "local_only", "push_allowed", "not_applicable"]
        },
        "checkpoint_eligibility_status": {
          "type": "string",
          "enum": ["not_checked", "eligible", "ineligible", "blocked"]
        },
        "project_checkpoint_status": {
          "type": "string",
          "enum": ["not_required", "pending", "passed", "failed", "blocked"]
        },
        "entry_criteria": { "$ref": "#/$defs/listOrNone" },
        "exit_criteria": { "$ref": "#/$defs/listOrNone" },
        "required_next_role": { "$ref": "#/$defs/controlOrTargetRole" },
        "gate_evidence": { "$ref": "#/$defs/listOrNone" },
        "blocking_status": {
          "oneOf": [
            { "const": "NONE" },
            { "$ref": "#/$defs/blockingStatus" }
          ]
        },
        "notes": { "$ref": "#/$defs/listOrNone" }
      }
    },
    "actionSemantic": {
      "type": "string",
      "enum": ["normal", "wait_for_owner", "pause", "stop_terminal", "completed_state_transition"]
    },
    "controlOrOwnerRole": {
      "type": "string",
      "enum": [
        "orchestrator",
        "requirements_analyst",
        "solution_architect",
        "designer",
        "developer",
        "auditor",
        "tester",
        "technical_writer",
        "devops_setup_engineer",
        "release_manager",
        "project_owner"
      ]
    },
    "controlOrTargetRole": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "solution_architect",
        "designer",
        "developer",
        "auditor",
        "tester",
        "technical_writer",
        "devops_setup_engineer",
        "release_manager",
        "orchestrator",
        "project_owner",
        "none"
      ]
    },
    "listOrNone": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string" } }
      ]
    },
    "blockingStatus": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "blocker_id",
        "blocker_type",
        "blocks",
        "blocked_by",
        "resolution_path"
      ],
      "properties": {
        "blocker_id": { "type": "string" },
        "blocker_type": {
          "type": "string",
          "enum": ["owner_decision", "pause", "audit_fail", "gap", "runtime", "dependency", "governance", "other"]
        },
        "blocks": { "type": "string" },
        "blocked_by": { "type": "string" },
        "resolution_path": { "type": "string" }
      }
    }
  }
}
