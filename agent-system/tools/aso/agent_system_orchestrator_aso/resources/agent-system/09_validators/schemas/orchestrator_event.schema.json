{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/orchestrator_event.schema.json",
  "title": "ORCHESTRATOR_EVENT",
  "description": "Stage 2 envelope sidecar for project-runtime/ORCHESTRATOR_EVENTS_LOG.md event entries.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sidecar_type",
    "markdown_source",
    "state_revision",
    "updated_at",
    "updated_by",
    "content"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "sidecar_type": { "type": "string", "const": "ORCHESTRATOR_EVENT" },
    "markdown_source": { "type": "string", "const": "project-runtime/ORCHESTRATOR_EVENTS_LOG.md" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "const": "orchestrator" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "date",
        "event_type",
        "actor",
        "task_id",
        "gate_id",
        "action_id",
        "status",
        "summary",
        "input_refs",
        "output_refs",
        "commit_hash",
        "branch",
        "push_status",
        "accepted_files",
        "failure_reason",
        "next_action_ref"
      ],
      "properties": {
        "date": { "type": "string" },
        "event_type": {
          "type": "string",
          "enum": [
            "bootstrap",
            "owner_pause",
            "validator_result",
            "checkpoint",
            "manual_intervention",
            "task_dispatch",
            "result_route",
            "audit_route",
            "correction_route",
            "state_update",
            "violation_recovery"
          ]
        },
        "actor": { "type": "string", "enum": ["orchestrator", "project_owner", "validator", "system"] },
        "task_id": { "type": "string" },
        "gate_id": { "type": "string" },
        "action_id": { "type": "string" },
        "status": { "type": "string" },
        "summary": { "type": "string" },
        "input_refs": { "$ref": "#/$defs/listOrNone" },
        "output_refs": { "$ref": "#/$defs/listOrNone" },
        "commit_hash": { "type": "string" },
        "branch": { "type": "string" },
        "push_status": { "type": "string", "enum": ["not_required", "not_attempted", "pushed", "failed"] },
        "accepted_files": { "$ref": "#/$defs/listOrNone" },
        "failure_reason": { "type": "string" },
        "next_action_ref": { "type": "string" }
      }
    },
    "listOrNone": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
