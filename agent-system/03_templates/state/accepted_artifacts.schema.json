{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aso.local/state/accepted_artifacts.schema.json",
  "title": "ACCEPTED_ARTIFACTS sidecar",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sidecar_type",
    "markdown_source",
    "state_revision",
    "updated_at",
    "updated_by",
    "content"
  ],
  "properties": {
    "schema_version": {
      "const": "2.0.0"
    },
    "sidecar_type": {
      "const": "ACCEPTED_ARTIFACTS"
    },
    "markdown_source": {
      "const": "project-runtime/ACCEPTED_ARTIFACTS.md"
    },
    "state_revision": {
      "type": "integer",
      "minimum": 1
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_by": {
      "type": "string",
      "minLength": 1
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifacts"
      ],
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "artifact_id",
              "path",
              "task_id",
              "accepted_result_ref",
              "audit_ref",
              "status",
              "commit_hash",
              "notes"
            ],
            "properties": {
              "artifact_id": {
                "type": "string",
                "minLength": 1
              },
              "path": {
                "type": "string",
                "minLength": 1
              },
              "task_id": {
                "type": "string",
                "minLength": 1
              },
              "accepted_result_ref": {
                "type": "string",
                "minLength": 1
              },
              "audit_ref": {
                "type": "string"
              },
              "status": {
                "type": "string",
                "enum": [
                  "accepted",
                  "superseded",
                  "rejected"
                ]
              },
              "commit_hash": {
                "type": "string"
              },
              "notes": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  }
}
