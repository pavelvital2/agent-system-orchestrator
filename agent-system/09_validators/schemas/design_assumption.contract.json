{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/design_assumption.contract.json",
  "title": "DESIGN_ASSUMPTION",
  "description": "Corrected P4 design assumption contract. Assumptions must remain explicit, bounded, owner-visible, and linked to gaps or questions when they affect owner decisions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project_id",
    "assumption_id",
    "statement",
    "why_this_is_reasonable",
    "owner_visible_impact",
    "used_in_documents",
    "review_trigger",
    "if_wrong_then",
    "promote_to_gap",
    "gap_refs",
    "question_refs",
    "status",
    "audit_refs"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0.0" },
    "project_id": { "type": "string", "minLength": 1 },
    "assumption_id": { "type": "string", "pattern": "^ASM-[A-Za-z0-9._-]+$" },
    "statement": { "type": "string", "minLength": 1 },
    "why_this_is_reasonable": { "type": "string", "minLength": 1 },
    "owner_visible_impact": { "type": "string", "minLength": 1 },
    "used_in_documents": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "review_trigger": { "type": "string", "minLength": 1 },
    "if_wrong_then": { "type": "string", "minLength": 1 },
    "promote_to_gap": {
      "type": "string",
      "enum": ["yes", "no", "already_linked"]
    },
    "gap_refs": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string", "pattern": "^GAP-[A-Za-z0-9._-]+$" } }
      ]
    },
    "question_refs": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string", "pattern": "^Q-[A-Za-z0-9._-]+$" } }
      ]
    },
    "status": {
      "type": "string",
      "enum": ["draft", "active", "ready_for_audit", "accepted", "retired", "superseded"]
    },
    "audit_refs": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string", "minLength": 1 } }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "promote_to_gap": { "enum": ["yes", "already_linked"] } },
        "required": ["promote_to_gap"]
      },
      "then": {
        "properties": {
          "gap_refs": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^GAP-[A-Za-z0-9._-]+$" }
          }
        }
      }
    }
  ]
}
