{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/accepted_artifacts.schema.json",
  "title": "ACCEPTED_ARTIFACTS",
  "description": "Stage 2 envelope sidecar for project-runtime/ACCEPTED_ARTIFACTS.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sidecar_type",
    "markdown_source",
    "state_revision",
    "updated_at",
    "updated_by",
    "content"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "sidecar_type": { "type": "string", "const": "ACCEPTED_ARTIFACTS" },
    "markdown_source": { "type": "string", "const": "project-runtime/ACCEPTED_ARTIFACTS.md" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "const": "orchestrator" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["artifacts"],
      "properties": {
        "artifacts": {
          "oneOf": [
            { "const": "NONE" },
            { "type": "array", "items": { "$ref": "#/$defs/artifactEntry" } }
          ]
        }
      }
    },
    "artifactEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "artifact_id",
        "artifact_type",
        "artifact_ref",
        "status",
        "source_task",
        "source_result_ref",
        "audit_ref",
        "supersedes",
        "superseded_by",
        "commit_hash",
        "branch",
        "push_status",
        "checkpoint_ref",
        "accepted_at",
        "updated_at",
        "notes"
      ],
      "properties": {
        "artifact_id": { "type": "string" },
        "artifact_type": { "type": "string" },
        "artifact_ref": { "type": "string" },
        "status": { "type": "string", "enum": ["draft", "accepted", "failed", "superseded"] },
        "source_task": { "type": "string" },
        "source_result_ref": { "type": "string" },
        "audit_ref": { "type": "string" },
        "supersedes": { "type": "string" },
        "superseded_by": { "type": "string" },
        "commit_hash": { "type": "string" },
        "branch": { "type": "string" },
        "push_status": { "type": "string", "enum": ["not_required", "not_attempted", "pushed", "failed"] },
        "checkpoint_ref": { "type": "string" },
        "accepted_at": { "type": "string" },
        "updated_at": { "type": "string" },
        "notes": { "type": "string" }
      }
    }
  }
}
