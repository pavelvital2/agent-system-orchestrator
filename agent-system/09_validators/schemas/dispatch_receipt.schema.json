{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/dispatch_receipt.schema.json",
  "title": "DISPATCH_RECEIPT",
  "description": "Machine-checkable external runner dispatch evidence for one profile-agent instance.",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "receipt_type",
    "schema_version",
    "agent_instance_id",
    "runner",
    "model",
    "reasoning_effort",
    "prompt_ref",
    "task_id",
    "role",
    "started_at",
    "handoff_ref",
    "receipt_ref",
    "external_runner_command_template",
    "live_dispatch_performed_by_aso"
  ],
  "properties": {
    "receipt_type": { "const": "DISPATCH_RECEIPT" },
    "schema_version": { "const": "1.0.0" },
    "agent_instance_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "runner": {
      "type": "string",
      "enum": ["external_codex_cli"]
    },
    "runner_semantics": {
      "type": "string",
      "minLength": 1
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "reasoning_effort": {
      "type": "string",
      "enum": ["low", "medium", "high", "xhigh"]
    },
    "prompt_ref": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["NONE", "none", "null", "UNKNOWN"] }
    },
    "task_id": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["NONE", "none", "null", "UNKNOWN"] }
    },
    "role": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "solution_architect",
        "developer",
        "tester",
        "auditor",
        "technical_writer"
      ]
    },
    "started_at": {
      "type": "string",
      "format": "date-time"
    },
    "handoff_ref": {
      "type": "string",
      "minLength": 1,
      "not": { "enum": ["NONE", "none", "null", "UNKNOWN"] }
    },
    "receipt_ref": {
      "type": "string",
      "pattern": "^project-runtime/agents/dispatches/[A-Za-z0-9_.:-]+\\.json$"
    },
    "receipt_path": {
      "type": "string"
    },
    "external_runner_command_template": {
      "const": "codex exec -C <WORKSPACE_ROOT> -m <MODEL> -c model_reasoning_effort=\"<REASONING_EFFORT>\" - < <PROMPT_REF>"
    },
    "live_dispatch_performed_by_aso": { "const": false }
  }
}
