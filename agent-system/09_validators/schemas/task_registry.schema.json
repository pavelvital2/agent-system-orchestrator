{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/task_registry.schema.json",
  "title": "TASK_REGISTRY",
  "description": "Stage 2 envelope sidecar for project-runtime/TASK_REGISTRY.md.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "sidecar_type",
    "markdown_source",
    "state_revision",
    "updated_at",
    "updated_by",
    "content"
  ],
  "properties": {
    "schema_version": { "type": "string", "const": "2.0.0" },
    "sidecar_type": { "type": "string", "const": "TASK_REGISTRY" },
    "markdown_source": { "type": "string", "const": "project-runtime/TASK_REGISTRY.md" },
    "state_revision": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "updated_by": { "type": "string", "const": "orchestrator" },
    "content": { "$ref": "#/$defs/content" }
  },
  "$defs": {
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry_revision", "tasks"],
      "properties": {
        "registry_revision": { "type": "integer", "minimum": 1 },
        "tasks": {
          "oneOf": [
            { "const": "NONE" },
            { "type": "array", "items": { "$ref": "#/$defs/taskEntry" } }
          ]
        }
      }
    },
    "taskEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_id",
        "task_title",
        "task_type",
        "task_kind",
        "owner_role",
        "status",
        "task_packet",
        "dependencies",
        "requested_by_role",
        "requested_by_task",
        "return_to_requester_after_audit_pass",
        "return_to_role_after_audit_pass",
        "return_task_after_audit_pass",
        "research_question_id",
        "result_refs",
        "audit_refs",
        "correction_links",
        "commit_hash",
        "branch",
        "push_status",
        "accepted_files",
        "checkpoint_ref",
        "created_at",
        "updated_at"
      ],
      "properties": {
        "task_id": { "type": "string" },
        "task_title": { "type": "string" },
        "task_type": { "$ref": "#/$defs/profileRole" },
        "task_kind": {
          "type": "string",
          "enum": ["bootstrap", "normal", "research_dependency", "design_continuation", "task_continuation", "correction", "audit", "testing", "setup", "launch", "handover"]
        },
        "owner_role": { "$ref": "#/$defs/controlOrTargetRole" },
        "status": {
          "type": "string",
          "enum": [
            "pending",
            "ready",
            "running",
            "audit_pending",
            "audit_passed",
            "checkpoint_done",
            "blocked",
            "failed",
            "superseded",
            "completed"
          ]
        },
        "task_packet": { "type": "string" },
        "dependencies": { "$ref": "#/$defs/listOrNone" },
        "requested_by_role": {
          "oneOf": [
            { "$ref": "#/$defs/profileRole" },
            { "const": "NONE" }
          ]
        },
        "requested_by_task": { "type": "string" },
        "return_to_requester_after_audit_pass": { "type": "boolean" },
        "return_to_role_after_audit_pass": {
          "oneOf": [
            { "$ref": "#/$defs/profileRole" },
            { "const": "none" }
          ]
        },
        "return_task_after_audit_pass": { "type": "string" },
        "research_question_id": { "type": "string" },
        "result_refs": { "$ref": "#/$defs/listOrNone" },
        "result_acceptance_mode": { "type": "string", "enum": ["result_only", "artifact_package"] },
        "artifact_package_required": { "type": "boolean" },
        "audit_refs": { "$ref": "#/$defs/listOrNone" },
        "correction_links": { "$ref": "#/$defs/listOrNone" },
        "commit_hash": { "type": "string" },
        "branch": { "type": "string" },
        "push_status": { "type": "string", "enum": ["not_required", "not_attempted", "pushed", "failed"] },
        "accepted_files": { "$ref": "#/$defs/listOrNone" },
        "checkpoint_ref": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      }
    },
    "profileRole": {
      "type": "string",
      "enum": [
        "requirements_analyst",
        "solution_architect",
        "designer",
        "developer",
        "auditor",
        "tester",
        "technical_writer",
        "devops_setup_engineer",
        "release_manager"
      ]
    },
    "controlOrTargetRole": {
      "type": "string",
      "enum": [
        "orchestrator",
        "requirements_analyst",
        "solution_architect",
        "designer",
        "developer",
        "auditor",
        "tester",
        "technical_writer",
        "devops_setup_engineer",
        "release_manager",
        "project_owner",
        "none"
      ]
    },
    "listOrNone": {
      "oneOf": [
        { "const": "NONE" },
        { "type": "array", "items": { "type": "string" } }
      ]
    }
  }
}
