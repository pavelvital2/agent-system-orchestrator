{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-system.local/schemas/orchestrator_runtime_contract.schema.json",
  "title": "ORCHESTRATOR_RUNTIME_CONTRACT",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "contract_version",
    "package_version",
    "governance_ruleset_version",
    "runtime_schema_version",
    "artifact_package_schema_version",
    "allowed_roles",
    "forbidden_dispatch_roles",
    "role_registry",
    "allowed_events",
    "state_transitions",
    "forbidden_transitions",
    "next_actions_by_state",
    "required_docs_by_role",
    "reasoning_floor_by_role",
    "dispatch_receipt_contract",
    "handoff_artifact_contract",
    "artifact_contracts",
    "audit_gate_rules",
    "checkpoint_rules",
    "routine_context_policy",
    "handoff_context_builder_contract",
    "source_boundary_contract"
  ],
  "properties": {
    "contract_version": {
      "type": "string",
      "minLength": 1
    },
    "package_version": {
      "type": "string",
      "minLength": 1
    },
    "governance_ruleset_version": {
      "type": "string",
      "minLength": 1
    },
    "runtime_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "artifact_package_schema_version": {
      "type": "string",
      "minLength": 1
    },
    "allowed_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "forbidden_dispatch_roles": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "role_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dispatchable_role_ids",
        "legacy_lifecycle_system_role_ids",
        "control_or_pseudo_role_ids",
        "forbidden_dispatch_role_ids"
      ],
      "properties": {
        "dispatchable_role_ids": {
          "type": "array",
          "items": {
            "enum": [
              "requirements_analyst",
              "solution_architect",
              "developer",
              "tester",
              "auditor",
              "technical_writer"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "legacy_lifecycle_system_role_ids": {
          "type": "array",
          "items": {
            "enum": ["designer", "devops_setup_engineer", "release_manager"]
          },
          "uniqueItems": true
        },
        "control_or_pseudo_role_ids": {
          "type": "array",
          "items": {
            "enum": ["orchestrator", "project_owner", "owner", "control", "none"]
          },
          "uniqueItems": true
        },
        "forbidden_dispatch_role_ids": {
          "type": "array",
          "items": {
            "enum": ["orchestrator", "owner", "control", "release_manager"]
          },
          "uniqueItems": true
        }
      }
    },
    "allowed_events": {
      "type": "array",
      "items": {
        "enum": [
          "CREATE_AGENT_RECOMMENDED",
          "CREATE_AGENT_DISPATCHED",
          "RESULT_RECEIVED",
          "RESULT_VALIDATED",
          "RESULT_ACCEPTED",
          "ARTIFACT_PACKAGE_RECEIVED",
          "ARTIFACT_VALIDATED",
          "ARTIFACT_ACCEPTED",
          "AGENT_TERMINATED",
          "AUDIT_ROUTE_READY",
          "AUDIT_RESULT_RECEIVED_PASS",
          "AUDIT_RESULT_RECEIVED_FAIL",
          "CORRECTION_REQUIRED",
          "CHECKPOINT_ELIGIBLE",
          "CHECKPOINT_PREFLIGHT_PASS",
          "CHECKPOINT_COMMITTED_OR_ARCHIVED",
          "FINALIZE",
          "PROJECT_COMPLETED",
          "NO_NEXT_ACTION"
        ]
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "event_aliases": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "string"
          },
          {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          }
        ]
      }
    },
    "state_transitions": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "terminal_states": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "forbidden_transitions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "from_states",
          "event",
          "reason"
        ],
        "properties": {
          "from_states": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "minItems": 1
          },
          "event": {
            "type": "string",
            "minLength": 1
          },
          "same_task": {
            "type": "boolean"
          },
          "reason": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    },
    "next_actions_by_state": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "$ref": "#/$defs/nextAction"
      }
    },
    "next_action_aliases": {
      "type": "object",
      "additionalProperties": {
        "type": "array",
        "items": {
          "type": "string"
        }
      }
    },
    "required_docs_by_role": {
      "type": "object",
      "required": [
        "requirements_analyst",
        "solution_architect",
        "developer",
        "tester",
        "auditor",
        "technical_writer"
      ],
      "properties": {
        "requirements_analyst": { "$ref": "#/$defs/docTokenArray" },
        "solution_architect": { "$ref": "#/$defs/docTokenArray" },
        "developer": { "$ref": "#/$defs/docTokenArray" },
        "tester": { "$ref": "#/$defs/docTokenArray" },
        "auditor": { "$ref": "#/$defs/docTokenArray" },
        "technical_writer": { "$ref": "#/$defs/docTokenArray" }
      },
      "additionalProperties": {
        "$ref": "#/$defs/docTokenArray"
      }
    },
    "reasoning_floor_by_role": {
      "type": "object",
      "required": [
        "requirements_analyst",
        "solution_architect",
        "developer",
        "tester",
        "auditor",
        "technical_writer"
      ],
      "properties": {
        "requirements_analyst": { "$ref": "#/$defs/reasoningFloor" },
        "solution_architect": { "$ref": "#/$defs/reasoningFloor" },
        "developer": { "$ref": "#/$defs/reasoningFloor" },
        "tester": { "$ref": "#/$defs/reasoningFloor" },
        "auditor": { "$ref": "#/$defs/reasoningFloor" },
        "technical_writer": { "$ref": "#/$defs/reasoningFloor" }
      },
      "additionalProperties": {
        "$ref": "#/$defs/reasoningFloor"
      }
    },
    "dispatch_receipt_contract": {
      "type": "object",
      "required": [
        "schema_ref",
        "template_ref",
        "receipt_ref_template",
        "required_fields",
        "runner",
        "runner_semantics",
        "external_runner_command_template",
        "writer_command_template",
        "live_dispatch_performed_by_aso"
      ],
      "properties": {
        "schema_ref": { "type": "string", "minLength": 1 },
        "template_ref": { "type": "string", "minLength": 1 },
        "receipt_ref_template": {
          "type": "string",
          "const": "project-runtime/agents/dispatches/<AGENT_INSTANCE_ID>.json"
        },
        "required_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "runner": {
          "type": "string",
          "enum": ["external_codex_cli"]
        },
        "runner_semantics": { "type": "string", "minLength": 1 },
        "external_runner_command_template": {
          "type": "string",
          "minLength": 1
        },
        "writer_command_template": { "type": "string", "minLength": 1 },
        "live_dispatch_performed_by_aso": { "const": false }
      },
      "additionalProperties": true
    },
    "handoff_artifact_contract": {
      "type": "object",
      "required": [
        "schema_ref",
        "template_ref",
        "handoff_ref_template",
        "prompt_ref_template",
        "expected_result_ref_template",
        "expected_audit_result_ref_template",
        "expected_artifact_package_ref_template",
        "required_fields",
        "forbidden_governance_corpus_rule",
        "runner",
        "runner_semantics",
        "external_runner_command_template",
        "live_dispatch_performed_by_aso"
      ],
      "properties": {
        "schema_ref": {
          "type": "string",
          "const": "agent-system/09_validators/schemas/orchestrator_handoff.schema.json"
        },
        "template_ref": {
          "type": "string",
          "const": "agent-system/03_templates/orchestrator_handoff.template.json"
        },
        "handoff_ref_template": {
          "type": "string",
          "const": "project-runtime/handoffs/<TASK_ID>.json"
        },
        "prompt_ref_template": {
          "type": "string",
          "const": "project-runtime/handoffs/<TASK_ID>.prompt.md"
        },
        "expected_result_ref_template": {
          "type": "string",
          "const": "project-runtime/results/worker/RESULT_<TASK_ID>_ATTEMPT_001.md"
        },
        "expected_audit_result_ref_template": {
          "type": "string",
          "const": "project-runtime/results/audit/AUDIT_RESULT_<TASK_ID>_ATTEMPT_001.md"
        },
        "expected_artifact_package_ref_template": {
          "type": "string",
          "const": "project-runtime/artifacts/candidates/<TASK_ID>/manifest.json"
        },
        "required_fields": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "forbidden_governance_corpus_rule": { "type": "string", "minLength": 1 },
        "runner": {
          "type": "string",
          "enum": ["external_codex_cli"]
        },
        "runner_semantics": { "type": "string", "minLength": 1 },
        "external_runner_command_template": { "type": "string", "minLength": 1 },
        "live_dispatch_performed_by_aso": { "const": false }
      },
      "additionalProperties": true
    },
    "artifact_contracts": {
      "type": "object",
      "required": [
        "candidate_manifest_canonical",
        "accepted_manifest_canonical"
      ],
      "properties": {
        "candidate_manifest_canonical": {
          "type": "string",
          "const": "manifest.json"
        },
        "candidate_manifest_legacy_aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "accepted_manifest_canonical": {
          "type": "string",
          "const": "manifest.json"
        }
      },
      "additionalProperties": true
    },
    "audit_gate_rules": {
      "type": "object",
      "required": [
        "audit_pass_allows_checkpoint",
        "audit_fail_routes_correction",
        "audit_fail_blocks_checkpoint"
      ],
      "properties": {
        "audit_pass_allows_checkpoint": { "const": true },
        "audit_fail_routes_correction": { "const": true },
        "audit_fail_blocks_checkpoint": { "const": true }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "checkpoint_rules": {
      "type": "object",
      "required": [
        "requires_audit_pass",
        "requires_no_open_lifecycle_blockers",
        "requires_state_consistency"
      ],
      "properties": {
        "requires_audit_pass": { "const": true },
        "requires_no_open_lifecycle_blockers": { "const": true },
        "requires_state_consistency": { "const": true }
      },
      "additionalProperties": {
        "type": "boolean"
      }
    },
    "routine_context_policy": {
      "type": "object",
      "required": [
        "orchestrator_must_read",
        "orchestrator_must_not_read_routinely",
        "reference_docs_allowed_only_for",
        "context_budget",
        "stdout_policy"
      ],
      "properties": {
        "orchestrator_must_read": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "orchestrator_must_not_read_routinely": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "reference_docs_allowed_only_for": {
          "type": "array",
          "items": {
            "enum": [
              "bootstrap",
              "debug",
              "violation_recovery",
              "specific_validator_reference"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "context_budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "max_routine_files",
            "max_lines_per_file",
            "routine_reference_docs_allowed"
          ],
          "properties": {
            "max_routine_files": {
              "type": "integer",
              "minimum": 1,
              "maximum": 12
            },
            "max_lines_per_file": {
              "type": "integer",
              "minimum": 1,
              "maximum": 300
            },
            "routine_reference_docs_allowed": { "const": false }
          }
        },
        "stdout_policy": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "default",
            "full_report_requires",
            "full_diff_or_report_in_stdout_by_default"
          ],
          "properties": {
            "default": { "const": "summary_only" },
            "full_report_requires": {
              "type": "array",
              "items": {
                "enum": ["--json-out", "--format json"]
              },
              "minItems": 1,
              "uniqueItems": true
            },
            "full_diff_or_report_in_stdout_by_default": { "const": false }
          }
        }
      },
      "additionalProperties": true
    },
    "handoff_context_builder_contract": {
      "type": "object",
      "required": [
        "normal_context_mode",
        "allowed_context_modes",
        "runtime_contract_required_sections",
        "routine_handoff_includes",
        "routine_handoff_excludes",
        "reference_doc_inclusion_rule",
        "role_doc_access_policy",
        "target_role_doc_map"
      ],
      "properties": {
        "normal_context_mode": {
          "const": "routine"
        },
        "allowed_context_modes": {
          "type": "array",
          "items": {
            "enum": [
              "routine",
              "debug",
              "explain",
              "violation_recovery"
            ]
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "runtime_contract_required_sections": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "routine_handoff_includes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "routine_handoff_excludes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "reference_doc_inclusion_rule": {
          "type": "string",
          "minLength": 1
        },
        "role_doc_access_policy": {
          "type": "string",
          "minLength": 1
        },
        "target_role_doc_map": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": true
    },
    "source_boundary_contract": {
      "type": "object",
      "required": [
        "schema_ref",
        "template_ref",
        "allowed_sources_ref_template",
        "severity_order",
        "severity_tiers",
        "correction_required_for",
        "fresh_agent_required_for",
        "allowed_delivery_context_classes",
        "correction_routing_rule"
      ],
      "properties": {
        "schema_ref": {
          "const": "agent-system/09_validators/schemas/allowed_sources.schema.json"
        },
        "template_ref": {
          "const": "agent-system/03_templates/allowed_sources.template.json"
        },
        "allowed_sources_ref_template": {
          "const": "project-runtime/handoffs/<TASK_ID>.allowed_sources.json"
        },
        "severity_order": {
          "type": "array",
          "prefixItems": [
            { "const": "SB0_ALLOWED" },
            { "const": "SB1_REPORTING_ONLY" },
            { "const": "SB2_GOVERNANCE_WARNING" },
            { "const": "SB3_BLOCKING" },
            { "const": "SB4_INVALIDATING" }
          ],
          "minItems": 5,
          "maxItems": 5
        },
        "severity_tiers": {
          "type": "object",
          "required": [
            "SB0_ALLOWED",
            "SB1_REPORTING_ONLY",
            "SB2_GOVERNANCE_WARNING",
            "SB3_BLOCKING",
            "SB4_INVALIDATING"
          ],
          "additionalProperties": {
            "type": "object",
            "required": ["label", "meaning", "recommended_action", "correction_required"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "meaning": { "type": "string", "minLength": 1 },
              "recommended_action": { "type": "string", "minLength": 1 },
              "correction_required": { "type": "boolean" }
            },
            "additionalProperties": true
          }
        },
        "correction_required_for": {
          "type": "array",
          "items": { "enum": ["SB3_BLOCKING", "SB4_INVALIDATING"] },
          "minItems": 2,
          "maxItems": 2,
          "uniqueItems": true
        },
        "fresh_agent_required_for": {
          "type": "array",
          "items": { "const": "SB4_INVALIDATING" },
          "minItems": 1,
          "maxItems": 1
        },
        "allowed_delivery_context_classes": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1,
          "uniqueItems": true
        },
        "default_forbidden_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "uniqueItems": true
        },
        "correction_routing_rule": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": true
    }
  },
  "$defs": {
    "docTokenArray": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1,
      "uniqueItems": true
    },
    "reasoningFloor": {
      "enum": [
        "medium",
        "high",
        "xhigh",
        "maximum"
      ]
    },
    "nextAction": {
      "type": "object",
      "required": [
        "recommended_next_action",
        "action_type",
        "dispatchable"
      ],
      "properties": {
        "recommended_next_action": {
          "type": "string",
          "minLength": 1
        },
        "action_type": {
          "type": "string",
          "enum": [
            "create_agent",
            "route_result",
            "update_state",
            "wait_for_owner",
            "correction",
            "finalize",
            "stop"
          ]
        },
        "target_role": {
          "type": "string"
        },
        "target_role_source": {
          "type": "string"
        },
        "checkpoint_policy": {
          "type": "string"
        },
        "dispatchable": {
          "type": "boolean"
        }
      },
      "additionalProperties": true
    }
  }
}
